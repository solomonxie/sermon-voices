{
  "transcription": {
    "model": "base",
    "language": "auto",
    "device": "metal"
  },
  "translation": {
    "target_languages": ["en", "zh", "es", "ko"],
    "ollama_model": "llama3",
    "ollama_url": "http://localhost:11434"
  },
  "tts": {
    "engine": "coqui-xtts",
    "use_voice_cloning": true,
    "languages": ["en", "zh", "es", "ko"],
    "gpu_acceleration": "mps"
  },
  "voice_cloning": {
    "sample_duration_sec": 15,
    "auto_extract_from_sermon": true
  },
  "output": {
    "base_dir": "./output/sermons",
    "generate_index": true,
    "formats": ["markdown", "pdf", "text"],
    "organize_by": "author"
  },
  "object_storage": {
    "enabled": false,
    "type": "s3",
    "bucket": "sermon-voices",
    "endpoint": "http://localhost:9000",
    "access_key": "",
    "secret_key": "",
    "auto_upload": false
  },
  "paths": {
    "python_scripts": "./python",
    "models": "./models"
  }
}
